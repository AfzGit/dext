#!/bin/bash

#-----------------------------------------------------------
#| DEFAULTS                                                |
#-----------------------------------------------------------

dryrun=false
copy=false
unique=false
force=false

#-----------------------------------------------------------
#| FUNCTIONS                                               |
#-----------------------------------------------------------
# Help, MakeList, DryRun, MakeDirs, CopyMove, _uniqname, _cpmv

Help()
{
    echo "Organize files having the same extension in a folder automatically"
    echo
    echo "USAGE:"
    echo "   dext [OPTIONS]"
    echo "   dext [OPTIONS] DIRECTORY"
    echo
    echo "OPTIONS:"
    echo "   -h"
    echo "       Show this help message"
    echo "   -u"
    echo "       Show total Unique extensions"
    echo "   -v"
    echo "       Verbose mode"
    echo "   -c"
    echo "       Copy mode (default is Move)"
    echo "   -d"
    echo "       Dry run"
    echo "   -f"
    echo "       Force move/copy files (no prompts; rename all conflicts)"
    echo
    echo "EXAMPLES:"
    echo "   dext ~/Downloads/           # Move"
    echo "   dext -v -c ~/Downloads/     # Verbose copy"
    echo "   dext -f ~/Downloads/        # Force move"
    echo "   dext -f -c ~/Downloads/     # Force copy"
    echo "   dext -d ~/Downloads/        # Dry run"
    echo
    echo "CONTRIBUTE:"
    echo "   https://github.com/AfzGit/dext"
}

#-----------------------------------------------------------
#| MAKE LIST                                                |
#-----------------------------------------------------------
MakeList()
{
    local file ext

    extensions=()
    declare -A seen_extensions=()

    shopt -s nullglob

    for file in *; do
        [[ -f $file ]] || continue

        if [[ $file =~ \.([[:alnum:]_]+)$ ]]; then
            ext=${BASH_REMATCH[1]}

            # Preserve original Dext behavior.
            ext=${ext//_/}

            [[ -n $ext ]] || continue

            if [[ -z ${seen_extensions[$ext]+x} ]]; then
                seen_extensions["$ext"]=1
                extensions+=("$ext")
            fi
        fi
    done

    shopt -u nullglob

    if ((${#extensions[@]} == 0)); then
        echo "No file extensions detected"
        exit
    fi

    # Keep the original alphabetical sorting.
    mapfile -t extensions < <(
        printf '%s\n' "${extensions[@]}" | sort
    )

    extnum=${#extensions[@]}

    # Build [ext1, ext2, ext3]
    listinline="["
    local i

    for i in "${!extensions[@]}"; do
        ((i > 0)) && listinline+=", "
        listinline+=${extensions[i]}
    done

    listinline+="]"
}

#-----------------------------------------------------------
#| DRY RUN                                                  |
#-----------------------------------------------------------

DryRun()
{
    local n ext file
    local -a files

    echo "$listinline"

    for n in "${!extensions[@]}"; do
        ext=${extensions[n]}

        echo
        echo "[$((n + 1))/$extnum] $ext"
        echo "============"

        shopt -s nullglob
        files=( *."$ext" )
        shopt -u nullglob

        if ((${#files[@]})); then
            printf '%s\n' "${files[@]}"
        fi

        echo "============"
    done

    echo

    if $copy; then
        echo "-> COPYING The above files"
    else
        echo "-> MOVING The above files"
    fi

    echo "-> Directories = $listinline"
}

#-----------------------------------------------------------
#| MAKE DIRECTORIES                                         |
#-----------------------------------------------------------

MakeDirs()
{
    local ext

    for ext in "${extensions[@]}"; do
        if [[ ! -d $ext ]]; then
            mkdir -- "$ext"
        else
            echo "  -> Directory exists, skipping \"$ext\"..."
        fi
    done
}

#-----------------------------------------------------------
#| UNIQUE NAME                                               |
#-----------------------------------------------------------
# Find a destination name that does not already exist and
# has not already been claimed during this operation.
#
# This function ONLY finds a name. It does not claim it.
# The caller claims the name after deciding to use it.
#
_uniqname()
{
    local -n _u_claimed=$1
    local -n _u_out=$4

    local _u_dir=$2
    local _u_base=$3

    local _u_stub
    local _u_ext
    local _u_cand=$_u_base
    local _u_c=0

    [[ $_u_base =~ ^(\.)?([^.]*)(.*)$ ]]

    _u_stub=${BASH_REMATCH[1]}${BASH_REMATCH[2]}
    _u_ext=${BASH_REMATCH[3]}

    while [[ -e "$_u_dir/$_u_cand" ||
		     -L "$_u_dir/$_u_cand" ||
             -v '_u_claimed[$_u_cand]' ]]; do
        ((++_u_c))
        _u_cand="$_u_stub ($_u_c)$_u_ext"
    done

    _u_out=$_u_cand
}


#-----------------------------------------------------------
#| COPY / MOVE                                               |
#-----------------------------------------------------------
# Collision modes:
#
#   ask     Ask [Y/n/a/s]
#   rename  Rename all collisions
#   skip    Skip all collisions
#
_cpmv()
{
    local cmd=$1
    local -n _cpmv_collision_mode=$2
    shift 2

    if (($# < 2)); then
        echo "${cmd}: usage: ${cmd} <collision_mode> <source...> <destination>" >&2
        return 1
    fi

    local -a extra=()
    local -a batch=()
    local -a sources=()

    local dest
    local src
    local base
    local cand
    local answer
    local failed=0

    case $cmd in
        cp)
            extra+=(-a)
            ;;
        mv)
        	extra+=(-n)
            ;;
        *)
            echo "Unsupported command: $cmd" >&2
            return 1
            ;;
    esac

    $verbose && extra+=(-v)

    # Last argument is the destination.
    dest=${!#}

    # Everything before it is a source.
    sources=("${@:1:$#-1}")

    if [[ ! -d $dest ]]; then
        echo "${cmd}: destination is not a directory: $dest" >&2
        return 1
    fi

    # Names already used/claimed during this operation.
    local -A claimed=()

    for src in "${sources[@]}"; do

        base=${src##*/}

        #---------------------------------------------------
        #| NO COLLISION
        #---------------------------------------------------

        if [[ ! -e "$dest/$base" &&
        	  ! -L "$dest/$base" &&
              ! -v 'claimed[$base]' ]]; then

            batch+=("$src")
            claimed["$base"]=1

            continue
        fi

        #---------------------------------------------------
        #| FIND UNIQUE NAME
        #---------------------------------------------------

        _uniqname claimed "$dest" "$base" cand

        #---------------------------------------------------
        #| COLLISION MODE
        #---------------------------------------------------

        case $_cpmv_collision_mode in

            #-----------------------------------------------
            #| SKIP ALL
            #-----------------------------------------------

            skip)
                continue
                ;;

            #-----------------------------------------------
            #| RENAME ALL
            #-----------------------------------------------

            rename)
                ;;

            #-----------------------------------------------
            #| ASK
            #-----------------------------------------------

            ask)
                while true; do

                    printf 'Rename "%s" → "%s"? [Y/n/a/s] ' \
                        "$base" "$cand"

                    read -r answer

                    case ${answer:-Y} in

                        Y|y)
                            break
                            ;;

                        n|N)
                            cand=
                            break
                            ;;

                        a|A)
                            _cpmv_collision_mode=rename
                            break
                            ;;

                        s|S)
                            _cpmv_collision_mode=skip
                            cand=
                            break
                            ;;

                        *)
                            echo "Please answer Y, n, a, or s."
                            ;;
                    esac
                done
                ;;
        esac

        # User selected n or s.
        [[ -n $cand ]] || continue

        # Claim the name only after accepting it.
        claimed["$cand"]=1

        #---------------------------------------------------
        #| PERFORM RENAMED OPERATION
        #---------------------------------------------------

        if $copy; then
            cp "${extra[@]}" -- "$src" "$dest/$cand" || failed=1
        else
            mv "${extra[@]}" -- "$src" "$dest/$cand" || failed=1
        fi
    done

    #-------------------------------------------------------
    #| BATCH NON-CONFLICTING FILES
    #-------------------------------------------------------

    if ((${#batch[@]})); then

        if $copy; then
            cp "${extra[@]}" -- "${batch[@]}" "$dest" || failed=1
        else
            mv "${extra[@]}" -- "${batch[@]}" "$dest" || failed=1
        fi

    fi

    return "$failed"
}

#-----------------------------------------------------------
#| COPY / MOVE FILES                                        |
#-----------------------------------------------------------

CopyMove()
{
    local ext
    local -a files

    # This state deliberately lives outside _cpmv().
    #
    # It therefore persists across ALL extensions, meaning:
    #
    #   a = rename all remaining conflicts
    #   s = skip all remaining conflicts
    #
    local collision_mode=ask

    # -f is equivalent to choosing "a" immediately.
    if $force; then
        collision_mode=rename
    fi

    for ext in "${extensions[@]}"; do

        shopt -s nullglob
        files=( *."$ext" )
        shopt -u nullglob

        ((${#files[@]})) || continue

        if $copy; then
            _cpmv cp collision_mode "${files[@]}" "$ext"
        else
            _cpmv mv collision_mode "${files[@]}" "$ext"
        fi
    done

    echo "  -> Finished working on $extnum directories"
}

#-----------------------------------------------------------
#| OPTIONS                                                   |
#-----------------------------------------------------------

while getopts ":hudcvf" option; do
    case $option in

        h)
            Help
            exit
            ;;

        u)
            unique=true
            ;;

        d)
            dryrun=true
            ;;

        c)
            copy=true
            ;;

        v)
            verbose=true
            ;;

        f)
            force=true
            ;;

        \?)
            echo "Error: Invalid option. Check help 'dext -h'."
            exit 1
            ;;
    esac
done

shift $((OPTIND - 1))

#-----------------------------------------------------------
#| MAIN                                                      |
#-----------------------------------------------------------

# Dext accepts zero or one directory argument.
if (($# > 1)); then
    echo "Error: too many arguments. Check help 'dext -h'."
    exit 1
fi

workingdir=${1:-.}

if [[ ! -d $workingdir ]]; then
    echo "$workingdir Directory not found"
    exit 1
fi

cd -- "$workingdir" || exit 1

MakeList

#-----------------------------------------------------------
#| FORCE MODE                                                |
#-----------------------------------------------------------
# -f skips all normal confirmation prompts and automatically
# accepts all collision renames.
#
if $force; then

    MakeDirs
    CopyMove

#-----------------------------------------------------------
#| DRY RUN                                                   |
#-----------------------------------------------------------

elif $dryrun; then

    DryRun

#-----------------------------------------------------------
#| UNIQUE EXTENSIONS                                         |
#-----------------------------------------------------------

elif $unique; then

    echo "=== $extnum Unique Extensions in $(pwd) ==="
    echo "$listinline"

#-----------------------------------------------------------
#| NORMAL MODE                                               |
#-----------------------------------------------------------

else

    echo "=== $extnum Unique Extensions in $(pwd) ==="
    echo
    echo "$listinline"
    echo

    #-------------------------------------------------------
    #| DIRECTORY CONFIRMATION
    #-------------------------------------------------------

    read -r -p \
        "-> Make $extnum directories of the above extensions? [Y/n] " \
        choice

    if [[ -n $choice && $choice != Y && $choice != y ]]; then
        echo "Stopped."
        exit
    fi

    MakeDirs
    echo "  -> Directories made"

    #-------------------------------------------------------
    #| COPY / MOVE CONFIRMATION
    #-------------------------------------------------------

    if $copy; then

        read -r -p "-> Copy all files? [Y/n] " choice

    else

        read -r -p "-> Move all files? [Y/n] " choice

    fi

    if [[ -n $choice && $choice != Y && $choice != y ]]; then
        echo "Stopped."
        exit
    fi

    CopyMove
fi
